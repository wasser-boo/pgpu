# Compose-Env für den VPS-Stack (vps-compose.yml). Kopieren nach .env, chmod 600!
# Alles läuft per Env — kein Master-Password-Prompt beim Start (nur der
# Migrations-Pfad braucht MASTER_KEY, s. vps/praxis-state/).

# Reusable NetBird-Setup-Key für den VPS-Peer (tgrid → Setup Keys → neu,
# Typ reusable, Gruppen: test, servers — s. README "VPS-Deploy").
NB_SETUP_KEY=

# GPU-Router: API/Dashboard-Bearer + Dashboard-Login. Gleiches Token wie
# GPU_ROUTER_TOKEN in vps/praxis.env!
ROUTER_TOKEN=

# Vast.ai API-Key (https://cloud.vast.ai/create/ → API Keys).
VAST_API_KEY=

# NetBird-PAT (nbp_...) — mintet ephemere Setup-Keys pro GPU-Box.
NB_API_TOKEN=

# NUR für die Migration einer vorhandenen Installation (entsperrt die
# gemountete secrets.enc2). Frischer Env-only-Start: leer lassen!
MASTER_KEY=

# Vosk-Sprachen für das STT-Sidecar (RAM: de≈4,5 GB, ja≈1,5 GB, fr≈2 GB).
STT_LANGUAGES=de,ja
