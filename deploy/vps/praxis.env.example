# Praxis-Container (vps-compose.yml) — env_file für den praxis-Service.
# Kopieren nach vps/praxis.env und ausfüllen (Hilfe: bash vps/gen-secrets.sh
# erzeugt starke Werte für GATEWAY_API_KEY + DASHBOARD_ADMIN_PASSWORD).
# chmod 600! Alles läuft per Env — ohne Master-Password-Prompt, ohne
# Onboarding-Zwang (nur wenn unten DISCORD_BOT_TOKEN gesetzt wird, startet
# der Discord-Bot).

# --- Gateway / Dashboard -----------------------------------------------
GATEWAY_PORT=3537
# Echtes Secret (>= 32 Zeichen), NICHT der alte Testwert:
GATEWAY_API_KEY=bitte-durch-ein-echtes-secret-ersetzen
# Dashboard-Login-Passwort (ohne Setzung generiert Praxis eines und loggt
# es einmal — in Containern ist das Log nach Restart weg: setzen!):
DASHBOARD_ADMIN_PASSWORD=bitte-durch-ein-echtes-passwort-ersetzen

# --- LLM (über den GPU-Router im selben Namespace: loopback) -----------
USE_PROVIDER=llamacpp
LLAMACPP_API_BASE=http://127.0.0.1:11434
LLAMACPP_MODEL=qwen3.6-35b-a3b

# --- GPU-Router-Integration (Wake/State/Job-Id, Bauplan §12.4) ----------
GPU_ROUTER_URL=http://127.0.0.1:8080
GPU_ROUTER_TOKEN=derselbe-wie-ROUTER_TOKEN-in-.env
GPU_ROUTER_WAIT_S=120

# --- Media/STT (Router-Passthrough, gleiche Ports wie direkt) ----------
COMFYUI_BASE_URL=http://127.0.0.1:8188
VOSK_SERVER_URL=ws://127.0.0.1:2700

# --- Secrets (NICHT hier!) ---------------------------------------------
# Externe Secrets (DISCORD_BOT_TOKEN, OPENAI_API_KEY, ELEVENLABS_API_KEY …)
# gehören NICHT in diese Datei: Sie landen verschlüsselt im Secret-Store
# (/opt/praxis/state/secrets.enc2) und werden über das DASHBOARD (Settings)
# eingetragen — so kann die Agent-Shell (shared VM-mode) sie nie lesen.
# Zustellung des Master-Keys: vps/master_key (root:root 0600, s. gen-secrets.sh)
# → Compose-Secret → tmpfs → Praxis liest+löscht.

# --- POML ----------------------------------------------------------------
POML_CLI=/opt/praxis/poml/python/poml/js/cli.js
